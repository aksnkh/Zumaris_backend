{
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/identity/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "{**catch-all}"
          }
        ]
      },
      "service-request-route": {
        "ClusterId": "service-request-cluster",
        "Match": {
          "Path": "/service-request/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "{**catch-all}"
          }
        ]
      },
      "property-route": {
        "ClusterId": "property-cluster",
        "Match": {
          "Path": "/property/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "{**catch-all}"
          }
        ]
      },
      "service-catalog-route": {
        "ClusterId": "service-catalog-cluster",
        "Match": {
          "Path": "/service-catalog/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "{**catch-all}"
          }
        ]
      },
      "provider-route": {
        "ClusterId": "provider-cluster",
        "Match": {
          "Path": "/provider/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "{**catch-all}"
          }
        ]
      },
      "billing-route": {
        "ClusterId": "billing-cluster",
        "Match": {
          "Path": "/billing/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/billing"
          }
        ]
      },
      "document-route": {
        "ClusterId": "document-cluster",
        "Match": {
          "Path": "/document/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/document"
          }
        ]
      },
      "maintenance-route": {
        "ClusterId": "maintenance-cluster",
        "Match": {
          "Path": "/maintenance/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/maintenance"
          }
        ]
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-srv": {
            "Address": "http://127.0.0.1:5001"
          }
        }
      },
      "service-request-cluster": {
        "Destinations": {
          "service-request-srv": {
            "Address": "http://127.0.0.1:5002"
          }
        }
      },
      "property-cluster": {
        "Destinations": {
          "property-srv": {
            "Address": "http://127.0.0.1:5003"
          }
        }
      },
      "service-catalog-cluster": {
        "Destinations": {
          "service-catalog-srv": {
            "Address": "http://127.0.0.1:5006"
          }
        }
      },
      "provider-cluster": {
        "Destinations": {
          "provider-srv": {
            "Address": "http://127.0.0.1:5007"
          }
        }
      },
      "billing-cluster": {
        "Destinations": {
          "billing-srv": {
            "Address": "http://127.0.0.1:5008"
          }
        }
      },
      "document-cluster": {
        "Destinations": {
          "document-srv": {
            "Address": "http://127.0.0.1:5004"
          }
        }
      },
      "maintenance-cluster": {
        "Destinations": {
          "maintenance-srv": {
            "Address": "http://127.0.0.1:5005"
          }
        }
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "https://app.zumaris.com",
      "https://tech.zumaris.com",
      "https://admin.zumaris.com"
    ]
  }
}
