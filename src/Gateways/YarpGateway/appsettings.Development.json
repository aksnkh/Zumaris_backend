{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-srv": {
            "Address": "http://127.0.0.1:5105"
          }
        }
      },
      "service-request-cluster": {
        "Destinations": {
          "service-request-srv": {
            "Address": "http://127.0.0.1:5106"
          }
        }
      },
      "property-cluster": {
        "Destinations": {
          "property-srv": {
            "Address": "http://127.0.0.1:5107"
          }
        }
      },
      "service-catalog-cluster": {
        "Destinations": {
          "service-catalog-srv": {
            "Address": "http://127.0.0.1:5110"
          }
        }
      }
    }
  }
}
