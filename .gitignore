# Visual Studio user settings
.vs/
*.user
*.suo

# .NET build outputs
**/bin/
**/obj/
TestResults/

# Per-machine credentials; loaded by Service Request and included only in local publish output.
**/appsettings.Local.json

# Provider local tooling and IIS publish settings
/src/Services/Provider/Provider.Api/.config/dotnet-tools.json
/src/Services/Provider/Provider.Api/Properties/PublishProfiles/IISProduction.pubxml

# Billing build/publish artifacts accidentally written into the source directory
/src/Services/Billing/Billing.Api/*.dll
/src/Services/Billing/Billing.Api/*.exe
/src/Services/Billing/Billing.Api/*.pdb
/src/Services/Billing/Billing.Api/*.deps.json
/src/Services/Billing/Billing.Api/*.runtimeconfig.json
